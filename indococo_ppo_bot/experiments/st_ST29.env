# ST29 = ST25's recipe (BEST: ST24 config = ST23 + ST20r_final@2.0 in
# EXTRA_OPPS, FR4_final 0.816, demo_threat 0.15 @ [1800,3000], aerial_defense
# 0.15; OPPCH 0.70, ppo epochs 1, ST21 league weights, B0=indococo-train-rip-
# 9d4b2a6) plus ONE change, in train_st29.toml: reward_config =
# experiments/st28.toml (st.toml + demo.victim_punishment 1.0 -> 3.0, a demo on
# us costs 150 instead of 50).
# Why: ST26/ST27 (ST25 without ST20r, ST27 also FR4_final 2.0) both finished
# below ST25 on h2h (49.0 / 48.8), FR4 (72.2 / 73.0 vs 78.4) and Galactus
# (34.6 / 38.8 vs 40.8), so ST29 goes back to ST25's league exactly. ST28 tests
# the demo penalty on the ST27 league from the ST25 checkpoint; ST29 runs the
# same penalty on the ST25 league, so ST29 vs ST28 isolates the league (ST20r
# back, FR4 2.0 -> 0.816) and ST29 vs ST25 isolates the penalty. Galactus is
# still the gen-panel min and 62% of its goals follow a demo on us (diag_gal
# ST25, 76/123). See EXPERIMENTS.md ST29.
# Realized shares at OPPCH 0.70 / total 17.427 (as ST25): Galactus 25.8%,
# Ripple 5.2%, Megabyte 8.0%, ST20r 8.0%, FR4 3.3%, self-play 30%.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
TRAIN_TMPL=train_st29.toml
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
EXTRA_OPPS="$EXTRA_OPPS ST20r_final:/home/ubuntu/ippo_runs/exp_ST20r/checkpoints/1794276990:2.0"
# Start-point rule (build on BEST, not on a non-promoted branch): on a fresh
# start, use BEST's selected checkpoint. The launcher's follow-up sets
# BESTF=st28_final when ST28 promotes (its FINAL_CKPT is the same checkpoint the
# launcher would pass), else the newest promote=true final (st25_final ->
# exp_ST25/checkpoints/1794413355). START is cleared so the launcher recomputes
# it (and END) from this checkpoint. Has no effect once exp_<RUN> has checkpoints.
if [[ -s "${BESTF:-}/FINAL_CKPT" ]] && ! ls $R_/exp_${RUN:-ST29}/checkpoints 2>/dev/null | grep -qE '^[0-9]+$'; then
  _bck=$(cat "$BESTF/FINAL_CKPT")
  if [[ -d "$_bck" && -s "$_bck/stats.toml" && "$_bck" != "${START_CK:-}" ]]; then
    echo "$(date '+%F %T %Z') ${RUN:-ST29} start-point rule: START_CK ${START_CK:-unset} -> $_bck (BEST $BESTF)" | tee -a $R_/exp_${RUN:-ST29}/logs/train.log
    START_CK=$_bck; START=
  fi
fi
# Mid evals every 100M.
CHUNK=100000000
