# ST7 (generalization): ST6 recipe (broader league + OPPCH 0.50) with one change:
# entropy 0.012 -> 0.016 so the policy explores more under the diverse opponent pool
# and is less likely to overfit self-play or any single style. Same Galactus 2.5,
# same EXTRA_OPPS, flip_reset 70. From ST6 best chunk.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.50; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/home/ubuntu/ippo_runs/code_fr9/bin/indococo-train-gal; GAL_WEIGHT=2.5
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="X0_final:$R_/exp_X0/checkpoints/1793405254:1.0 ADB_final:$R_/exp_ADB/checkpoints/1793420157:1.0 AUD_final:$R_/exp_AUD/checkpoints/1793475982:1.0 FR6_final:$R_/exp_FR6/checkpoints/1793540902:1.0 FR8c_final:$R_/exp_FR8c/checkpoints/1793716845:1.0 FR9c_final:$R_/exp_FR9c/checkpoints/1793762362:1.0 ST3_final:$R_/exp_ST3/checkpoints/1793809757:1.0"
