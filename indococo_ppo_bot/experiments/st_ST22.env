# ST22 = ST21 + air_dribble_wall_challenge at 10% of starts (ONE change vs ST21,
# plus B0=indococo-train-rip-9d4b2a6 which adds this setter; ST21 stays on e429d1a).
# Other setters keep ST21 relative proportions, scaled by 0.9: kickoff 0.324,
# random 0.108+0.108, replay 0.180, aerial_defense 0.135, demo_threat 0.045.
# SetterMix samples in [0, total weight), so this is 10% of episodes.
# League/OPPCH unchanged from ST21: OPPCH 0.60, GAL 6.429, MEGA 2.0, Ripple 1.286,
# others 0.816; realized shares Galactus 25.0%, Ripple 5.0%, Megabyte 7.8%,
# other league 22.2%, self-play 40%. RIPPLE_DEVICE=cuda.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
# Chains after ST21; measured vs BEST at launch (ST20r unless ST21 promotes).
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.60; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
TRAIN_TMPL=train_st22.toml
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
