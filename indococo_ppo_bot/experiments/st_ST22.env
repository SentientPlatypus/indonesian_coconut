# ST22 = ST21 + OPPCH 0.70 (ONE change: league fraction vs self-play 60% -> 70%).
# Everything else is the ST21 recipe exactly: same binary indococo-train-rip-e429d1a,
# RIPPLE_DEVICE=cuda, gal4 setters, same league weights (GAL 6.429, MEGA 2.0,
# Ripple toml 1.286, others 0.816; total 15.427). Relative league shares unchanged;
# with OPPCH 0.70 the realized shares are Galactus 29.2%, Ripple 5.8%,
# Megabyte 9.1%, other league (past_versions + FR4 + 5 EXTRA_OPPS) 25.9%, self-play 30%.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
# Chains after ST21; measured vs BEST at launch (ST20r, promoted 2026-11-10, unless ST21 promotes).
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-e429d1a; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
TRAIN_TMPL=train_st22.toml
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
