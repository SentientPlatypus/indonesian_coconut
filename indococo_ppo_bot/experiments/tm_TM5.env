# TM5 (EXPERIMENTS.md "TM5", docs/TM3_SPACING.md): spacing / role fixes on
# top of TM4. Reward tm5.toml (self-only banded teammate spacing, second-
# committer double commit 1000 uu, second-commit gate on touch / possession
# terms and the air-dribble sequence, last-man goalside and 3v3 support
# bands, concede_dist off, team_spirit 0.9 with goal / possession at 1.0;
# new terms ramp 20% -> 100% over 300M).
# Run with team_launch_tm5.sh (installed as the chain's team_launch.sh: adds
# the spacing metrics to the mids). 270-wide pred obs (OBS_PRED=1,
# START_IS_TEAM=1); start = TM4's latest chunk (the cut-over passes START_CK;
# $R_/TM5_START_CK overrides; fallback the team BEST). Mode mix and setters
# as TM4 (train_tm5.toml = train_tm4.toml); league as TM4 with the frozen
# TM2 final 0.30 split into TM3 final 0.20 + TM2 final 0.10. 1 epoch, no
# bf16, CHUNK 100M; critic warm-up 20M (new reward terms). 5B steps, LR hold
# to STEPS-1B then 1B cosine decay.
OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.50; PASTW=1.0
HOLDREL=4000000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-20000000}
STEPS=${STEPS:-5000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:-@B0@}
REWARD_TMPL=${REWARD_TMPL:-tm5.toml}; TRAIN_TMPL=train_tm5.toml
R_=${R:-/home/ubuntu/ippo_runs}
START_IS_TEAM=${START_IS_TEAM:-1}
TBF=$(cat $R_/team_best/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TBF" && -s "$TBF/actor.bpk" ]] || TBF=""
START_CK=${START_CK:-$TBF}
[[ -s $R_/TM5_START_CK ]] && START_CK=$(cat $R_/TM5_START_CK)
TM2F=$(cat $R_/tm2_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM2F" && -s "$TM2F/actor.bpk" ]] || TM2F=""
TM3F=$(cat $R_/tm3_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM3F" && -s "$TM3F/actor.bpk" ]] || TM3F=""
# League (of OPPCH; total 2.10 with past selves as TM4): past selves 1.0,
# Nexto 0.30 (20% sampled), Necto 0.13, Galactus 0.21, Megabyte 0.10, ST25
# 1v1 0.06, TM3 final 0.20 (270-wide), TM2 final 0.10 (235, widened on load).
GAL_WEIGHT=0.21; MEGA_WEIGHT=0.10
NEXTO_WEIGHT=0.30; NEXTO_STOCH=0.2; NECTO_WEIGHT=0.13; NECTO_STOCH=0.0
EXTRA_OPPS="ST25_1v1:$R_/exp_ST25/checkpoints/1794413355:0.06${TM3F:+ TM3_final:$TM3F:0.20}${TM2F:+ TM2_final:$TM2F:0.10}"
CHUNK=${CHUNK:-100000000}
