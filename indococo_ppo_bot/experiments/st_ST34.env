# ST34 (staged after the ST34 three-way cross-exam, Nov 13): the start
# point's own recipe plus ONE change, the reward: st34.toml = st.toml with
# face_ball 1.0 -> 0.1 and off the zero-sum path (see st34.toml header).
#  - ST33 promoted (BESTF=st33_final): train_st34p.toml (= train_st33.toml +
#    st34.toml) on binary indococo-train-st33 (opp_weights, learner_keeper).
#  - otherwise (BESTF=st25_final): train_st34.toml (= train_st25.toml +
#    st34.toml) on ST25's own binary indococo-train-rip-9d4b2a6.
# No code change: [zero_sum] face_ball = 0.0 leaves the term unwrapped
# (rewards/config.rs build wraps only opp_scale > 0); both binaries read it.
# League, PPO (1 epoch, no policy bf16, ENT 0.016, gamma 0.998, lambda 0.95),
# flip_reset 70, OPPCH 0.70, CHUNK 100M as ST25/ST33.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
R_=${ST34_R:-/home/ubuntu/ippo_runs}
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
EXTRA_OPPS="$EXTRA_OPPS ST20r_final:/home/ubuntu/ippo_runs/exp_ST20r/checkpoints/1794276990:2.0"
# Start-point rule (as ST29-ST33): on a fresh start, use BEST's selected
# checkpoint. The launcher's follow-up sets BESTF=st33_final when ST33 promotes
# (its FINAL_CKPT is the checkpoint the launcher already passes), else the newest
# promote=true final (st25_final -> exp_ST25/checkpoints/1794413355). START is
# cleared so the launcher recomputes it (and END). No effect on resumes.
_fresh=; ls $R_/exp_${RUN:-ST34}/checkpoints 2>/dev/null | grep -qE '^[0-9]+$' || _fresh=1
if [[ -n "$_fresh" && -s "${BESTF:-}/FINAL_CKPT" ]]; then
  _bck=$(cat "$BESTF/FINAL_CKPT")
  if [[ -d "$_bck" && -s "$_bck/stats.toml" && "$_bck" != "${START_CK:-}" ]]; then
    echo "$(date '+%F %T %Z') ${RUN:-ST34} start-point rule: START_CK ${START_CK:-unset} -> $_bck (BEST $BESTF)" | tee -a $R_/exp_${RUN:-ST34}/logs/train.log
    START_CK=$_bck; START=
  fi
fi
# Template follows the start point; decided once on the fresh start, reused on resumes.
_tf=$R_/exp_${RUN:-ST34}/TRAIN_TMPL
if [[ -z "$_fresh" && -s "$_tf" ]]; then TRAIN_TMPL=$(cat "$_tf")
else
  if [[ "${BESTF:-}" == */st33_final ]]; then TRAIN_TMPL=train_st34p.toml; else TRAIN_TMPL=train_st34.toml; fi
  mkdir -p $R_/exp_${RUN:-ST34}/logs; echo $TRAIN_TMPL > "$_tf"
  echo "$(date '+%F %T %Z') ${RUN:-ST34} template: $TRAIN_TMPL (BEST ${BESTF:-unset})" | tee -a $R_/exp_${RUN:-ST34}/logs/train.log
fi
# Binary follows the template (only copied into exp_ST34 on the fresh start).
if [[ "$TRAIN_TMPL" == train_st34p.toml ]]; then B0=/opt/dlami/nvme/ippo_bins/indococo-train-st33; fi
# Mid evals every 100M.
CHUNK=100000000
