# ST32 (reconciled after the ST30 diag + Discord/research/code cross-exam).
# = the start point's own recipe plus ONE change, in train_st32*.toml:
# demo_threat stays 0.15 of starts, but the drill is a learnable threat.
# Keeper 250-900 uu from its own goal line (grounded, facing the ball,
# boost 50-100), attacker 1800-3200 uu upfield inside a ±55° cone at
# 1950-2150 uu/s (~0.9-1.6 s to react), ball_threat on so the ball is
# driven into that net at 900-1450 uu/s and a missed dodge concedes in
# ~1-2 s. Rewards, PPO, league and the normal/kickoff majority are ST25's.
# See EXPERIMENTS.md ST32.
# Base follows the start point (one change vs the start point's own recipe):
#  - ST31 promoted (BESTF=st31_final): train_st32p.toml = ST31's template
#    (ST25 + 0.075 replay over preconcede_v2.f32) with the new demo_threat.
#  - otherwise (BESTF=st25_final): train_st32.toml = ST25's template with
#    the new demo_threat.
# Same league as ST25 / ST31 (ST20r_final 2.0 via EXTRA_OPPS, FR4 0.816 in the
# toml, Galactus 6.429, Megabyte 2.0, Ripple 1.286 in the toml), OPPCH 0.70,
# 1 epoch, CHUNK 100M, reward st.toml (flip_reset 70).
# Binary: a dedicated path, not the live ST31 binary. st_launch.sh sets
# B0 from ${BIN:-...} BEFORE sourcing this file, then this assignment wins.
# Build on the box and install there; do not overwrite
# /opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6 while ST31 is running.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-st32; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
R_=${ST32_R:-/home/ubuntu/ippo_runs}
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
EXTRA_OPPS="$EXTRA_OPPS ST20r_final:/home/ubuntu/ippo_runs/exp_ST20r/checkpoints/1794276990:2.0"
# Start-point rule (as ST29/ST30/ST31): on a fresh start, use BEST's selected
# checkpoint. The launcher's follow-up sets BESTF=st31_final when ST31 promotes
# (its FINAL_CKPT is the checkpoint the launcher already passes), else the newest
# promote=true final (st25_final -> exp_ST25/checkpoints/1794413355). START is
# cleared so the launcher recomputes it (and END). No effect on resumes.
_fresh=; ls $R_/exp_${RUN:-ST32}/checkpoints 2>/dev/null | grep -qE '^[0-9]+$' || _fresh=1
if [[ -n "$_fresh" && -s "${BESTF:-}/FINAL_CKPT" ]]; then
  _bck=$(cat "$BESTF/FINAL_CKPT")
  if [[ -d "$_bck" && -s "$_bck/stats.toml" && "$_bck" != "${START_CK:-}" ]]; then
    echo "$(date '+%F %T %Z') ${RUN:-ST32} start-point rule: START_CK ${START_CK:-unset} -> $_bck (BEST $BESTF)" | tee -a $R_/exp_${RUN:-ST32}/logs/train.log
    START_CK=$_bck; START=
  fi
fi
# Template follows the start point; decided once on the fresh start, reused on resumes.
_tf=$R_/exp_${RUN:-ST32}/TRAIN_TMPL
if [[ -z "$_fresh" && -s "$_tf" ]]; then TRAIN_TMPL=$(cat "$_tf")
else
  if [[ "${BESTF:-}" == */st31_final ]]; then TRAIN_TMPL=train_st32p.toml; else TRAIN_TMPL=train_st32.toml; fi
  mkdir -p $R_/exp_${RUN:-ST32}/logs; echo $TRAIN_TMPL > "$_tf"
  echo "$(date '+%F %T %Z') ${RUN:-ST32} template: $TRAIN_TMPL (BEST ${BESTF:-unset})" | tee -a $R_/exp_${RUN:-ST32}/logs/train.log
fi
# Mid evals every 100M.
CHUNK=100000000
