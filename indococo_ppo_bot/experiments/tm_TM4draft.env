# DRAFT, not queued (EXPERIMENTS.md "TM4-pre"). Proposed TM4 league with
# Nexto / Necto, for team_launch_tm4pre.sh only (team_launch.sh ignores
# NEXTO_WEIGHT / NECTO_WEIGHT). Starts from TM3's final, 270-wide
# (OBS_PRED=1, START_IS_TEAM=1), TM2/TM3 rewards, setters and PPO settings.
# Weights are of the OPPCH share and apply to all team sizes (one opponent
# per rollout across all arenas; per-mode weights would need collector work).
OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.50; PASTW=1.0
HOLDREL=8000000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-10000000}
STEPS=${STEPS:-9000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:-/opt/dlami/nvme/ippo_bins/indococo-train-tm4pre-@SHA@}
REWARD_TMPL=${REWARD_TMPL:-tm2.toml}; TRAIN_TMPL=train_tm2.toml
R_=${R:-/home/ubuntu/ippo_runs}
START_IS_TEAM=${START_IS_TEAM:-1}
TM3F=$(cat $R_/tm3_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM3F" && -s "$TM3F/actor.bpk" ]] || TM3F=""
START_CK=${START_CK:-$TM3F}
TM2F=$(cat $R_/tm2_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM2F" && -s "$TM2F/actor.bpk" ]] || TM2F=""
# League: past selves 1.0, Nexto 0.8 (20% of its episodes sampled), Necto 0.4,
# Galactus 0.6, Megabyte 0.25, ST25 1v1 0.15, TM2 final 0.3.
GAL_WEIGHT=0.6; MEGA_WEIGHT=0.25
NEXTO_WEIGHT=0.8; NEXTO_STOCH=0.2; NECTO_WEIGHT=0.4; NECTO_STOCH=0.0
EXTRA_OPPS="ST25_1v1:$R_/exp_ST25/checkpoints/1794413355:0.15${TM2F:+ TM2_final:$TM2F:0.3}"
CHUNK=${CHUNK:-100000000}
