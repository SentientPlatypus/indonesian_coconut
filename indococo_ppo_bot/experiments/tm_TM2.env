# TM2 (EXPERIMENTS.md "Cross-exam note — TM2"): follow-up of TM1 from its
# final (the launcher passes START_CK = TM1 best chunk, START_IS_TEAM=1).
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.40; PASTW=1.0
HOLDREL=1500000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-10000000}
STEPS=${STEPS:-3000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:-/opt/dlami/nvme/ippo_bins/indococo-train-tm2-620e718}
REWARD_TMPL=tm2.toml; TRAIN_TMPL=train_tm2.toml
R_=${R:-/home/ubuntu/ippo_runs}
START_IS_TEAM=${START_IS_TEAM:-1}
# TM1 final checkpoint: tm1_final/FINAL_CKPT, else the best TM1 mid-eval
# chunk (same score as the launcher final candidate), else none.
TM1F=$(cat $R_/tm1_final/FINAL_CKPT 2>/dev/null || true)
if [[ -z "$TM1F" || ! -s "$TM1F/actor.bpk" ]]; then
  TM1F=$(python3 - $R_/exp_TM1/logs/mid.jsonl 2>/dev/null <<'PY' || true
import json,sys
b=None
for l in open(sys.argv[1]):
    d=json.loads(l); s=((d.get("h2h_2v2") or 0)+(d.get("h2h_3v3") or 0))/2+0.25*(((d.get("gal_2v2") or 0)+(d.get("gal_3v3") or 0))/2)
    if b is None or s>=b[0]: b=(s,d["ckpt"])
print(b[1] if b else "")
PY
)
fi
[[ -n "$TM1F" && -s "$TM1F/actor.bpk" ]] || TM1F=""
START_CK=${START_CK:-$TM1F}
# BEST-team = TM1 final (user-approved Nov 14). Only when tm1_final is done,
# so TM2's guard, mids and gate compare against it. Atomic, idempotent; the
# previous value is kept in team_best/HISTORY.
if [[ -f $R_/tm1_final/DONE && -n "$TM1F" && "$(cat $R_/team_best/FINAL_CKPT 2>/dev/null)" != "$TM1F" ]]; then
  echo "$(date '+%F %T %Z') $(cat $R_/team_best/FINAL_CKPT 2>/dev/null) -> $TM1F (TM2 env)" >> $R_/team_best/HISTORY
  echo "$TM1F" > $R_/team_best/FINAL_CKPT.tmp.$$ && mv -f $R_/team_best/FINAL_CKPT.tmp.$$ $R_/team_best/FINAL_CKPT
fi
# League (of the OPPCH share): past selves 1.0, Galactus 0.8 (TM1 won 1-8%
# of team games vs Galactus), Megabyte 0.25, ST25 1v1 0.25 (106-wide, widened
# on load), the TM1 final 0.3 (frozen 235-wide team).
GAL_WEIGHT=0.8; MEGA_WEIGHT=0.25
EXTRA_OPPS="ST25_1v1:$R_/exp_ST25/checkpoints/1794413355:0.25${TM1F:+ TM1_final:$TM1F:0.3}"
CHUNK=${CHUNK:-100000000}
