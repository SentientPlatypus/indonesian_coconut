# TM3 (EXPERIMENTS.md "TM3"): obs-only change on top of TM2. Team-ext obs +
# ball prediction (5 no-car slices at +32/64/120/240/480 ticks) + nearest big
# pad = 270 inputs (INDOCOCO_OBS_PRED=1). Starts from TM2's final (the
# launcher passes START_CK = TM2 best chunk, START_IS_TEAM=1); the 235-wide
# seed is widened with `widen-pred` (35 zero first-layer rows on actor AND
# critic; fresh Adam since only actor/critic bpks are copied; critic warm-up
# 20M). Rewards, setters, mode mix and PPO settings are TM2's exactly
# (REWARD_TMPL=tm2.toml, TRAIN_TMPL=train_tm2.toml). Every mid / final eval
# runs on the TM3 binary with INDOCOCO_OBS_PRED=1: 235-wide (BEST-team, TM1 /
# TM2 finals) and 106-wide (ST25) nets are widened on load with zeros.
OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.40; PASTW=1.0
HOLDREL=1500000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-20000000}
STEPS=${STEPS:-3000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:-/opt/dlami/nvme/ippo_bins/indococo-train-tm3-36c7497}
REWARD_TMPL=${REWARD_TMPL:-tm2.toml}; TRAIN_TMPL=train_tm2.toml
R_=${R:-/home/ubuntu/ippo_runs}
START_IS_TEAM=${START_IS_TEAM:-1}
# TM2 final checkpoint: tm2_final/FINAL_CKPT, else the best TM2 mid-eval
# chunk (same score as the launcher final candidate), else none.
TM2F=$(cat $R_/tm2_final/FINAL_CKPT 2>/dev/null || true)
if [[ -z "$TM2F" || ! -s "$TM2F/actor.bpk" ]]; then
  TM2F=$(python3 - $R_/exp_TM2/logs/mid.jsonl 2>/dev/null <<'PY' || true
import json,sys
b=None
for l in open(sys.argv[1]):
    d=json.loads(l); s=((d.get("h2h_2v2") or 0)+(d.get("h2h_3v3") or 0))/2+0.25*(((d.get("gal_2v2") or 0)+(d.get("gal_3v3") or 0))/2)
    if b is None or s>=b[0]: b=(s,d["ckpt"])
print(b[1] if b else "")
PY
)
fi
[[ -n "$TM2F" && -s "$TM2F/actor.bpk" ]] || TM2F=""
START_CK=${START_CK:-$TM2F}
TM1F=$(cat $R_/tm1_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM1F" && -s "$TM1F/actor.bpk" ]] || TM1F=""
# League (of the OPPCH share), TM2's plus the TM2 final: past selves 1.0
# (exp_TM3/policy_versions starts empty, all 270-wide), Galactus 0.8,
# Megabyte 0.25, ST25 1v1 0.25 (106-wide), TM1 final 0.3 and TM2 final 0.3
# (235-wide, frozen; widened on load).
GAL_WEIGHT=0.8; MEGA_WEIGHT=0.25
EXTRA_OPPS="ST25_1v1:$R_/exp_ST25/checkpoints/1794413355:0.25${TM1F:+ TM1_final:$TM1F:0.3}${TM2F:+ TM2_final:$TM2F:0.3}"
CHUNK=${CHUNK:-100000000}
