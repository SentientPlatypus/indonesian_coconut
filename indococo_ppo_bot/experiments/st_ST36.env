# ST36 (after the ST36 three-way cross-exam, Nov 13/14): the start point's
# own recipe plus ONE change, the reward: st36.toml = st.toml plus
# shadow_box at weight 30 (PBRS, gamma 0.998, not zero-sum). See st36.toml.
#  - ST35 promoted (BESTF=st35_final): train_st36p.toml (= train_st35.toml +
#    st36.toml), PFSP on, Galactus clamp [0.25, 0.26], start ST35's final.
#  - otherwise (BESTF=st25_final): train_st36.toml (= train_st25.toml +
#    st36.toml), PFSP OFF, the ST25 fixed mix (Galactus ~25.8%), start ST25.
# Both on the same new binary (ST35 PFSP tree + this term). A single lever:
# do not turn PFSP on when starting from ST25.
# PPO (1 epoch, no policy bf16, ENT 0.016, gamma 0.998, lambda 0.95),
# flip_reset 70, OPPCH 0.70, CHUNK 100M as ST25/ST35.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-st36-1cbe86c; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
R_=${ST36_R:-/home/ubuntu/ippo_runs}
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
EXTRA_OPPS="$EXTRA_OPPS ST20r_final:/home/ubuntu/ippo_runs/exp_ST20r/checkpoints/1794276990:2.0"
# Start-point rule (as ST29-ST35): on a fresh start, use BEST's selected
# checkpoint. The launcher's follow-up sets BESTF=st35_final when ST35 promotes
# (its FINAL_CKPT is the checkpoint the launcher already passes), else the newest
# promote=true final (st25_final -> exp_ST25/checkpoints/1794413355). START is
# cleared so the launcher recomputes it (and END). No effect on resumes.
_fresh=; ls $R_/exp_${RUN:-ST36}/checkpoints 2>/dev/null | grep -qE '^[0-9]+$' || _fresh=1
if [[ -n "$_fresh" && -s "${BESTF:-}/FINAL_CKPT" ]]; then
  _bck=$(cat "$BESTF/FINAL_CKPT")
  if [[ -d "$_bck" && -s "$_bck/stats.toml" && "$_bck" != "${START_CK:-}" ]]; then
    echo "$(date '+%F %T %Z') ${RUN:-ST36} start-point rule: START_CK ${START_CK:-unset} -> $_bck (BEST $BESTF)" | tee -a $R_/exp_${RUN:-ST36}/logs/train.log
    START_CK=$_bck; START=
  fi
fi
# Template follows the start point; decided once on the fresh start, reused on resumes.
_tf=$R_/exp_${RUN:-ST36}/TRAIN_TMPL
if [[ -z "$_fresh" && -s "$_tf" ]]; then TRAIN_TMPL=$(cat "$_tf")
else
  if [[ "${BESTF:-}" == */st35_final ]]; then TRAIN_TMPL=train_st36p.toml; else TRAIN_TMPL=train_st36.toml; fi
  mkdir -p $R_/exp_${RUN:-ST36}/logs; echo $TRAIN_TMPL > "$_tf"
  echo "$(date '+%F %T %Z') ${RUN:-ST36} template: $TRAIN_TMPL (BEST ${BESTF:-unset})" | tee -a $R_/exp_${RUN:-ST36}/logs/train.log
fi
# League weights follow the template. Both templates use the same ST36 binary.
if [[ "$TRAIN_TMPL" == train_st36p.toml ]]; then
  GAL_WEIGHT=0.20
  MEGA_WEIGHT=0.09
  EXTRA_OPPS="ST25_final:/home/ubuntu/ippo_runs/exp_ST25/checkpoints/1794413355:0.09 HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.015"
fi
# Mid evals every 100M. No FR4 evals (launcher already dropped them from ST35 on).
CHUNK=100000000
