# ST25 = ST24 (ST23 + ST20r_final@2.0 in EXTRA_OPPS; OPPCH 0.70, ppo epochs 1,
# ST21 league weights, B0=indococo-train-rip-9d4b2a6) plus ONE change, in
# train_st25.toml: the demo_threat drill retuned to the Galactus failure mode.
# diag_gal ST23 vs Galactus (200 g): 59% of conceded goals follow a demo on us
# within 3.5 s (73/124; ST16 29%); win rate 9.7% in games with a demo on us vs
# ~63% without. Galactus closes from ~2.5k uu at ~2050 uu/s while we sit
# goal-side near our net. demo_threat 0.05 -> 0.15 of starts and distance
# [800,1500] -> [1800,3000]; normal play x0.875; aerial_defense stays 0.15.
# League, OPPCH, LR/ENT/TPI/MB, Galactus/Megabyte/Ripple weights, flip_reset 70
# all unchanged from ST24. Start ckpt left to the launcher (ST24 selected
# final, +1000M). BESTF at follow-up is st24_final if ST24 promotes, else
# st23_final.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
# Do NOT set START_CK here: a follow-up exec must be able to override it.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
TRAIN_TMPL=train_st25.toml
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
EXTRA_OPPS="$EXTRA_OPPS ST20r_final:/home/ubuntu/ippo_runs/exp_ST20r/checkpoints/1794276990:2.0"

# 2026-11-10: mid evals every 100M (was 50M) to cut eval downtime
CHUNK=100000000
