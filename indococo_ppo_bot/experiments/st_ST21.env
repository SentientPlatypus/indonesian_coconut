# ST21 (Galactus push): ST20 recipe (Ripple v1.1 at 5%, gal4 setters, same binary
# indococo-train-rip-e429d1a, RIPPLE_DEVICE=cuda, Megabyte share unchanged) with
# Galactus raised from 20% -> 25% of iterations. The +5% comes from the other
# league mix (past_versions + FR4 + EXTRA_OPPS), NOT from Ripple or Megabyte.
# League weights: base 5.712 (7 x 0.816) + GAL 6.429 + MEGA 2.0 + Ripple 1.286
# = 15.427 total, OPPCH 0.60 -> Galactus 25.0%, Megabyte 7.8%, Ripple 5.0%.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
# Chains after ST20r; measured vs ST19r (BEST; user declined ST20 promotion).
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.60; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-e429d1a; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
TRAIN_TMPL=train_st21.toml
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
