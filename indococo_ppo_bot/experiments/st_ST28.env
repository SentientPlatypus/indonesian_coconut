# ST28 = ST27 (ST26 + FR4_final league weight 0.816 -> 2.0; ST25 setters:
# demo_threat 0.15 @ [1800,3000], aerial_defense 0.15; OPPCH 0.70, ppo epochs
# 1, ST23 league without ST20r, B0=indococo-train-rip-9d4b2a6) with ONE change
# in train_st28.toml: reward_config = experiments/st28.toml, which is st.toml
# plus demo.victim_punishment 1.0 -> 3.0 (a demo on us costs 150, was 50).
# Why: vs Galactus (the gen-panel min) 62% of goals conceded follow a demo on
# us (diag_gal ST25); the ST25 demo drill gave exposure but did not lower that
# share, so ST28 strengthens the reward for avoiding the demo. See
# EXPERIMENTS.md ST28. EXTRA_OPPS, GAL_WEIGHT, MEGA_WEIGHT and the learner
# settings are ST27's.
# Start ckpt left to the launcher (ST27 selected final, +1000M). BESTF at
# follow-up is st27_final if ST27 promotes, else the newest promote=true
# final (st25_final).
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
# Do NOT set START_CK here: a follow-up exec must be able to override it.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
TRAIN_TMPL=train_st28.toml
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
# Mid evals every 100M.
CHUNK=100000000
