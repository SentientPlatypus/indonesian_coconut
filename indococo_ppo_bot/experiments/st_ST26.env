# ST26 = ST25 (ST24 config + demo_threat 0.15 @ [1800,3000]; OPPCH 0.70, ppo
# epochs 1, ST21 league weights, B0=indococo-train-rip-9d4b2a6) with ONE
# change: the fixed ST20r_final@2.0 league opponent is removed from EXTRA_OPPS.
# Evidence: ST24 (= ST23 + ST20r@2.0) finals vs ST23: h2h 53.6, FR4 77.0
# (BEST 79.6, gate fails by 2.6), pool 93.0 (93.21), bp5 67.0 (68.67, the
# metric ST20r was added for got worse), Galactus 37.0 (35.4). ST24 mid evals
# vs FR4 were flat (mean 76.2 vs ST23 76.1), so ST20r bought nothing
# measurable. Removing it returns the league to ST23's exactly (total weight
# 15.427): realized shares at OPPCH 0.70 are Galactus 29.2%, Ripple 5.8%,
# Megabyte 9.1%, other league 26.0%, self-play 30%. Setters (train_st26.toml)
# are ST25's unchanged, so ST26 tests the demo_threat retune without the
# ST20r opponent. Start ckpt left to the launcher (ST25 selected final,
# +1000M). BESTF at follow-up is st25_final if ST25 promotes, else the newest
# promote=true final (st23_final).
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
# Do NOT set START_CK here: a follow-up exec must be able to override it.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
TRAIN_TMPL=train_st26.toml
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"

# 2026-11-10: mid evals every 100M (was 50M) to cut eval downtime
CHUNK=100000000
