# ST27 = ST26 (ST25 setters: demo_threat 0.15 @ [1800,3000], aerial_defense
# 0.15; OPPCH 0.70, ppo epochs 1, ST23 league without ST20r,
# B0=indococo-train-rip-9d4b2a6) with ONE change in train_st27.toml:
# FR4_final's fixed league weight 0.816 -> 2.0 (realized share 3.7% -> 8.4%).
# Why: FR4 was the only gate ST25 missed (78.4 vs 79.6) and the FR4 diagnostic
# (diag_gal/st25_fr4_summary.txt) shows kickoff losses (44%) and aerial /
# out-of-position goals that only FR4 itself produces. ST24 showed that
# diluting FR4 in the league lowers FR4 (77.0). See EXPERIMENTS.md ST27.
# EXTRA_OPPS, GAL_WEIGHT, MEGA_WEIGHT and the learner settings are ST26's.
# Start ckpt left to the launcher (ST26 selected final). BESTF at follow-up
# is the newest promote=true final (st25_final unless ST26 promotes).
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
# Do NOT set START_CK here: a follow-up exec must be able to override it.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
TRAIN_TMPL=train_st27.toml
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
# Mid evals every 100M.
CHUNK=100000000
