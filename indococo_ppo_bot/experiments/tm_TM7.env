# TM7 (EXPERIMENTS.md "TM7 — Cross-exam note"): TM6 with stronger and
# wider too-close spacing plus a too-far penalty, a pass receiver
# separation gate and a role-scaled concede penalty. Reward tm7.toml
# (teammate_spacing 4.0 x [0.5 -> 1.0 over 200M], clear 1800, first man by
# role exempt; teammate_far 0.5 for non-first cars past 4500 uu over 1500;
# pass receiver paid only if >= 1200 uu from the passer at the passer's
# touch; concede_role 120 split first 0.7 / second 1.0 / last 1.3 by the
# roles 15 steps before the goal, team-normalized, individual). Obs 270
# (warm start as is). Everything else as TM6 (train_tm7.toml =
# train_tm6.toml; league as TM6). Start = TM6's last checkpoint (passed as
# START_CK by tm7_after_tm6.sh; $R_/TM7_START_CK overrides; fallback the
# team BEST = TM4 cut). BT = team_best (TM4 cut), read once at launch.
# Launcher: team_launch_tm7.sh (TM6 launcher + TM7 passive alarm).
# 1 epoch, no bf16, CHUNK 100M; critic warm-up 20M; 5B steps, LR 5e-5 held
# to STEPS-1B then 1B cosine to 0.4x.
OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.50; PASTW=1.0
HOLDREL=4000000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-20000000}
STEPS=${STEPS:-5000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:-/opt/dlami/nvme/ippo_bins/indococo-train-tm7-3c49c88}
REWARD_TMPL=${REWARD_TMPL:-tm7.toml}; TRAIN_TMPL=train_tm7.toml
R_=${R:-/home/ubuntu/ippo_runs}
START_IS_TEAM=${START_IS_TEAM:-1}
TBF=$(cat $R_/team_best/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TBF" && -s "$TBF/actor.bpk" ]] || TBF=""
START_CK=${START_CK:-$TBF}
[[ -s $R_/TM7_START_CK ]] && START_CK=$(cat $R_/TM7_START_CK)
TM2F=$(cat $R_/tm2_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM2F" && -s "$TM2F/actor.bpk" ]] || TM2F=""
TM3F=$(cat $R_/tm3_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM3F" && -s "$TM3F/actor.bpk" ]] || TM3F=""
# League as TM6 (of OPPCH; total 2.10 with past selves): past selves 1.0,
# Nexto 0.30 (20% sampled), Necto 0.13, Galactus 0.21, Megabyte 0.10, ST25
# 1v1 0.06, TM3 final 0.20 (270-wide), TM2 final 0.10 (235, widened on load).
GAL_WEIGHT=0.21; MEGA_WEIGHT=0.10
NEXTO_WEIGHT=0.30; NEXTO_STOCH=0.2; NECTO_WEIGHT=0.13; NECTO_STOCH=0.0
EXTRA_OPPS="ST25_1v1:$R_/exp_ST25/checkpoints/1794413355:0.06${TM3F:+ TM3_final:$TM3F:0.20}${TM2F:+ TM2_final:$TM2F:0.10}"
CHUNK=${CHUNK:-100000000}
# Passive alarm (team_launch_tm7.sh): TM6's rules and thresholds (no-challenger
# above 1.5x TM5r's baseline = 0.061 / 0.049) plus h2h vs BEST-team (TM4 cut)
# below 0.50 in a mode; any rule for 2 mids in a row -> $X/PASSIVE_ALARM.
NCR_BASE_2=0.0404; NCR_BASE_3=0.0329
H2H_ALARM=0.50
