# ST33 (reconciled after the ST32 three-way cross-exam, Nov 13): the start
# point's own recipe plus ONE change, in train_st33*.toml: opponent-conditioned
# threat starts. While a rollout plays Galactus, demo_threat is the recoverable
# ST32 drill at 0.30 (vs 0.15) with the learner as keeper (learner_keeper);
# self-play and all other opponents keep the base mix byte-for-byte.
#  - ST32 promoted (BESTF=st32_final): train_st33p.toml (ST32 mix base).
#  - otherwise (BESTF=st25_final): train_st33.toml (ST25 mix base, legacy
#    demo_threat 0.15 for everyone except Galactus iterations).
# League, PPO (1 epoch, no policy bf16, ENT 0.016, gamma 0.998, lambda 0.95),
# reward st.toml (flip_reset 70), OPPCH 0.70, CHUNK 100M as ST25/ST32.
# Binary: dedicated path; built from ic_ppo (opp_weights + rlgymppo
# opponent-pick hook). st_launch.sh copies B0 into exp_ST33 at start.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-st33; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
R_=${ST33_R:-/home/ubuntu/ippo_runs}
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
EXTRA_OPPS="$EXTRA_OPPS ST20r_final:/home/ubuntu/ippo_runs/exp_ST20r/checkpoints/1794276990:2.0"
# Start-point rule (as ST29-ST32): on a fresh start, use BEST's selected
# checkpoint. The launcher's follow-up sets BESTF=st32_final when ST32 promotes
# (its FINAL_CKPT is the checkpoint the launcher already passes), else the newest
# promote=true final (st25_final -> exp_ST25/checkpoints/1794413355). START is
# cleared so the launcher recomputes it (and END). No effect on resumes.
_fresh=; ls $R_/exp_${RUN:-ST33}/checkpoints 2>/dev/null | grep -qE '^[0-9]+$' || _fresh=1
if [[ -n "$_fresh" && -s "${BESTF:-}/FINAL_CKPT" ]]; then
  _bck=$(cat "$BESTF/FINAL_CKPT")
  if [[ -d "$_bck" && -s "$_bck/stats.toml" && "$_bck" != "${START_CK:-}" ]]; then
    echo "$(date '+%F %T %Z') ${RUN:-ST33} start-point rule: START_CK ${START_CK:-unset} -> $_bck (BEST $BESTF)" | tee -a $R_/exp_${RUN:-ST33}/logs/train.log
    START_CK=$_bck; START=
  fi
fi
# Template follows the start point; decided once on the fresh start, reused on resumes.
_tf=$R_/exp_${RUN:-ST33}/TRAIN_TMPL
if [[ -z "$_fresh" && -s "$_tf" ]]; then TRAIN_TMPL=$(cat "$_tf")
else
  if [[ "${BESTF:-}" == */st32_final ]]; then TRAIN_TMPL=train_st33p.toml; else TRAIN_TMPL=train_st33.toml; fi
  mkdir -p $R_/exp_${RUN:-ST33}/logs; echo $TRAIN_TMPL > "$_tf"
  echo "$(date '+%F %T %Z') ${RUN:-ST33} template: $TRAIN_TMPL (BEST ${BESTF:-unset})" | tee -a $R_/exp_${RUN:-ST33}/logs/train.log
fi
# Mid evals every 100M.
CHUNK=100000000
