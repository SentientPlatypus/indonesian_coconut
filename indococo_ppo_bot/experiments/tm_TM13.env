# shellcheck shell=bash
# TM13 variant (team_launch_tm13.sh). TM12 hyperparameters plus GCO-lite
# (tm13.toml), Galactus PFSP [0.10, 0.18], self_share 0.55, entropy 0.008,
# P1+L1+L2 speedups, 3v3 kickoff hygiene. Start and BT are the TM10 final.
# team_best is never written. L3 small critic is off. Critic extras off.
#
# One-line lever-4 flip (pre-goal team replay). 0 = weight 0 (off). 1 = 0.15,
# taken from aerial_pass / backboard_double_tap / air_near_ball. Flip this
# line (or export LEVER4=1 before launch) after the setter's round-trip tests
# AND tm13_smoke.sh pass; otherwise leave 0. Missing/empty banks are a no-op.
LEVER4=${LEVER4:-0}

OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.008; OPPCH=0.50; PASTW=1.0
HOLDREL=4000000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-20000000}
STEPS=${STEPS:-5000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:?set B0 to /opt/dlami/nvme/ippo_bins/indococo-train-tm13-<sha>}
REWARD_TMPL=tm13.toml
TRAIN_TMPL=train_tm13.toml
START_IS_TEAM=1
START_CK=${START_CK:-/home/ubuntu/ippo_runs/exp_TM10/checkpoints/1795503212}
BT_PIN=${BT_PIN:-/home/ubuntu/ippo_runs/exp_TM10/checkpoints/1795503212}
R_=${R:-/home/ubuntu/ippo_runs}
TM3F=$(cat $R_/tm3_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM3F" && -s "$TM3F/actor.bpk" ]] || TM3F=""
GAL_WEIGHT=0.21
NEXTO_WEIGHT=0.30; NEXTO_STOCH=0.2
NEXTO_KICKOFF_SCRIPT=${NEXTO_KICKOFF_SCRIPT:-true}
unset MEGA_WEIGHT NECTO_WEIGHT NECTO_STOCH
EXTRA_OPPS="${TM3F:+TM3_final:$TM3F:0.20}"
CHUNK=${CHUNK:-100000000}
NCR_BASE_2=${NCR_BASE_2:-}
NCR_BASE_3=${NCR_BASE_3:-}
H2H_ALARM=0.45          # vs TM10
TOUCH_DROP=0.15; DEPTH_DROP=0.20
PASSIVE_BASE=${PASSIVE_BASE:-/home/ubuntu/ippo_runs/tm13_work/passive_base.json}
GAL_JITTER=${GAL_JITTER:-1}
GAL_FIDELITY=${GAL_FIDELITY:-1}
CRITIC_EXTRAS=0
TM9_PIN=${TM9_PIN:-/home/ubuntu/ippo_runs/exp_TM9/checkpoints/1795388102}
TM9_GAMES=${TM9_GAMES:-400}
# Entropy floor alarm (tm12_eval.py). Mid entropy < 3.2 trips it.
ENTROPY_ALARM=${ENTROPY_ALARM:-3.2}
# P1 Nexto / intra (launcher appends into the nexto block / before first table).
# CONCURRENT_MIDS is reserved; team_launch_tm13.sh still uses the serial TM12
# mid loop (wiring it like team_launch_next.sh is a follow-up, not required to
# launch). Nexto 8/64/2 is the large P1 win.
NEXTO_REPLICAS=${NEXTO_REPLICAS:-8}
NEXTO_CHUNK=${NEXTO_CHUNK:-64}
NF_INTRA=${NF_INTRA:-2}
CONCURRENT_MIDS=${CONCURRENT_MIDS:-0}
# L1/L2 live in train_tm13.toml (mask_upload="auto", pinned_upload=true).
# Pre-goal banks (recorded later). Launcher substitutes @PREGOAL@.
PREGOAL=${PREGOAL:-$R_/exp_TM13/pregoal}
