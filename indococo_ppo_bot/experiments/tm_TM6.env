# TM6 (EXPERIMENTS.md "TM6 — Cross-exam note"): TM5r with role-based
# rewards. Reward tm6.toml (RoleTracker 300 uu / 8 steps; speed_to_ball,
# face_ball, aerial_boost, high_ball first man only; contact_quality x0.25
# off the first man; shadow_box / safe_boost non-first only; teammate_spacing
# 2.0 -> 1.0 over 100M with the first man by role exempt; double_commit 4.0
# on commit order; support_role 0.2 ramped 0 -> 1 over 200M; last man on the
# Last role 0.2 -> 0.3 over 200M; spacing / support / double-commit off in
# the kickoff phase). Everything else as TM5r (train_tm6.toml =
# train_tm5r.toml; league as TM5r). Start = TM5r's latest chunk (the
# cut-over passes START_CK; $R_/TM6_START_CK overrides; fallback the team
# BEST = TM4 cut). BT = team_best (TM4 cut), read once at launch. Launcher:
# team_launch_tm6.sh (TM5r launcher + role metrics + no-challenger alarm).
# 1 epoch, no bf16, CHUNK 100M; critic warm-up 20M; 5B steps, LR 5e-5 held
# to STEPS-1B then 1B cosine to 0.4x.
OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.50; PASTW=1.0
HOLDREL=4000000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-20000000}
STEPS=${STEPS:-5000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:-/opt/dlami/nvme/ippo_bins/indococo-train-tm6-a922fb6}
REWARD_TMPL=${REWARD_TMPL:-tm6.toml}; TRAIN_TMPL=train_tm6.toml
R_=${R:-/home/ubuntu/ippo_runs}
START_IS_TEAM=${START_IS_TEAM:-1}
TBF=$(cat $R_/team_best/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TBF" && -s "$TBF/actor.bpk" ]] || TBF=""
START_CK=${START_CK:-$TBF}
[[ -s $R_/TM6_START_CK ]] && START_CK=$(cat $R_/TM6_START_CK)
TM2F=$(cat $R_/tm2_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM2F" && -s "$TM2F/actor.bpk" ]] || TM2F=""
TM3F=$(cat $R_/tm3_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM3F" && -s "$TM3F/actor.bpk" ]] || TM3F=""
# League as TM5r (of OPPCH; total 2.10 with past selves): past selves 1.0,
# Nexto 0.30 (20% sampled), Necto 0.13, Galactus 0.21, Megabyte 0.10, ST25
# 1v1 0.06, TM3 final 0.20 (270-wide), TM2 final 0.10 (235, widened on load).
GAL_WEIGHT=0.21; MEGA_WEIGHT=0.10
NEXTO_WEIGHT=0.30; NEXTO_STOCH=0.2; NECTO_WEIGHT=0.13; NECTO_STOCH=0.0
EXTRA_OPPS="ST25_1v1:$R_/exp_ST25/checkpoints/1794413355:0.06${TM3F:+ TM3_final:$TM3F:0.20}${TM2F:+ TM2_final:$TM2F:0.10}"
CHUNK=${CHUNK:-100000000}
# Passive alarm (team_launch_tm6.sh): no-challenger rate of TM5r's latest
# checkpoint vs the TM4 cut (h2h, 400 games per mode, TM6 binary; TM5r @ 32.656B (exp_TM5r/checkpoints/1794916422));
# the alarm fires above 1.5x these for 2 mids in a row.
NCR_BASE_2=0.0404; NCR_BASE_3=0.0329
