# TM4 (EXPERIMENTS.md "TM4 — Cross-exam note"): long team run with Nexto /
# Necto in the league, for team_launch_tm4pre.sh (installed as the chain's
# team_launch.sh; the old launcher ignores NEXTO_WEIGHT / NECTO_WEIGHT).
# Starts from TM3's final (the follow-up passes START_CK = TM3 best chunk;
# $R_/TM4_START_CK, if present, overrides it), 270-wide (OBS_PRED=1,
# START_IS_TEAM=1), TM2/TM3 rewards (team_spirit 0.9) and setters, 1 epoch,
# no bf16, CHUNK 100M. Mode mix 1v1 0.15 / 2v2 0.35 / 3v3 0.50
# (train_tm4.toml = train_tm2.toml + that mix). 6.5B steps, LR hold to
# STEPS-1B then 1B cosine decay. Weights are of the OPPCH share and apply to
# all team sizes (one opponent per rollout across all arenas; per-mode
# weights would need collector work).
OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.50; PASTW=1.0
HOLDREL=5500000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-10000000}
STEPS=${STEPS:-6500000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:-/opt/dlami/nvme/ippo_bins/indococo-train-tm4pre-664faf7}
REWARD_TMPL=${REWARD_TMPL:-tm2.toml}; TRAIN_TMPL=train_tm4.toml
R_=${R:-/home/ubuntu/ippo_runs}
START_IS_TEAM=${START_IS_TEAM:-1}
TM3F=$(cat $R_/tm3_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM3F" && -s "$TM3F/actor.bpk" ]] || TM3F=""
START_CK=${START_CK:-$TM3F}
[[ -s $R_/TM4_START_CK ]] && START_CK=$(cat $R_/TM4_START_CK)
TM2F=$(cat $R_/tm2_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM2F" && -s "$TM2F/actor.bpk" ]] || TM2F=""
# League (total weight 2.10 with past selves; share = OPPCH x w / total):
# past selves 1.0 (23.8%), Nexto 0.30 (7.1%, 20% of its episodes sampled),
# Necto 0.13 (3.1%), Galactus 0.21 (5.0%), Megabyte 0.10 (2.4%), ST25 1v1
# 0.06 (1.4%), TM2 final 0.30 (7.1%). Before the first saved past version
# (250M steps; total 1.10): Nexto 13.6%, Necto 5.9%, Galactus 9.5%,
# Megabyte 4.5%, ST25 2.7%, TM2 final 13.6%.
GAL_WEIGHT=0.21; MEGA_WEIGHT=0.10
NEXTO_WEIGHT=0.30; NEXTO_STOCH=0.2; NECTO_WEIGHT=0.13; NECTO_STOCH=0.0
EXTRA_OPPS="ST25_1v1:$R_/exp_ST25/checkpoints/1794413355:0.06${TM2F:+ TM2_final:$TM2F:0.30}"
CHUNK=${CHUNK:-100000000}
