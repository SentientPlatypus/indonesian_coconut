# shellcheck shell=bash
# Shared path defaults for team / ST launchers.
#
# New launchers (TM11 onward) should source this file. Do not source it from
# any script TM10 or its waiter is currently executing: team_launch_tm10.sh,
# tm_TM10.env, tm10_window.sh, tm10_after_tm9.sh, or the live copies under
# code_tm / ic_ppo. Defaults match team_launch_tm10.sh so a future launcher
# can source this and resolve the same paths.
R=${R:-/home/ubuntu/ippo_runs}
LIBTORCH_LIB=${LIBTORCH_LIB:-$R/e8b2_1v1/bin/sp/torch/lib}
export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-$LIBTORCH_LIB}
PYT=${PYT:-/home/ubuntu/coco-venv/bin/python}
SNAP=${SNAP:-$R/fr7_snap}
GAL_DIR=${GAL_DIR:-/home/ubuntu/eval_bots/galactus/rust}
MEGA_DIR=${MEGA_DIR:-/home/ubuntu/eval_bots/megabyte}
NEXTO_DIR=${NEXTO_DIR:-/home/ubuntu/eval_bots/nexto}
NECTO_DIR=${NECTO_DIR:-/home/ubuntu/eval_bots/necto}
ST25_CK=${ST25_CK:-$R/exp_ST25/checkpoints/1794413355}
# TM9 final = current team_best (user-approved 2026-11-22 7:45 PM ET,
# America/New_York). TM10's live launcher still pins BT to the TM7 final.
TM9_CK=${TM9_CK:-$R/exp_TM9/checkpoints/1795388102}
TM7_CK=${TM7_CK:-$R/exp_TM7/checkpoints/1795170349}
MESH_REPO=${MESH_REPO:-/home/ubuntu/indonesian_coconut}
