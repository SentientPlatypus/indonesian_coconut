# ST30 = BEST's recipe plus ONE change, in train_st30*.toml: the synthetic
# demo_threat drill (0.15 of starts) is replaced by a replay setter (same 0.15)
# over real pre-demo states recorded vs Galactus (st30_snap/gal_demo.f32:
# the full 1v1 state 0.75 / 1.0 / 1.5 s before Galactus demoed ST25 or ST28,
# 1200 games, seeds 1000-1399 and 2000-2199, disjoint from diag seeds 0-99).
# Why: diag_gal (200 g) ST25 62% / ST28 68% of Galactus goals follow a demo
# on us within 3.5 s; 1 s before the demo we are grounded (95-97%), goal-side
# (95%), median 570-620 uu from our own goal line, ~91 boost, Galactus
# ~2.5k uu away at ~2050 uu/s, and 89-92% of those demos become a goal. The
# demo_threat setter never puts the target closer than 1120 uu to its goal
# line, puts a static ball anywhere, and has no option for either. ST28's 3x
# victim penalty did not move it (post-demo share 62% -> 68%, demos on us
# 115 -> 127 per 200 g). See EXPERIMENTS.md ST30.
# Base follows the start point (one change vs the start point's own recipe):
#  - ST29 promoted (BESTF=st29_final): train_st30p.toml = ST29 (ST25 league +
#    reward st28.toml, demo.victim_punishment 3.0).
#  - otherwise (BESTF=st25_final): train_st30.toml = ST25 (reward st.toml).
# The choice is written to exp_<RUN>/TRAIN_TMPL on the fresh start and reused
# on resumes. Realized shares at OPPCH 0.70 / total 17.427 (as ST25): Galactus
# 25.8%, Ripple 5.2%, Megabyte 8.0%, ST20r 8.0%, FR4 3.3%, self-play 30%.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
R_=${ST30_R:-/home/ubuntu/ippo_runs}
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
EXTRA_OPPS="$EXTRA_OPPS ST20r_final:/home/ubuntu/ippo_runs/exp_ST20r/checkpoints/1794276990:2.0"
# Start-point rule (as ST29): on a fresh start, use BEST's selected checkpoint.
# The launcher's follow-up sets BESTF=st29_final when ST29 promotes (its
# FINAL_CKPT is the checkpoint the launcher already passes), else the newest
# promote=true final (st25_final -> exp_ST25/checkpoints/1794413355). START is
# cleared so the launcher recomputes it (and END). No effect on resumes.
_fresh=; ls $R_/exp_${RUN:-ST30}/checkpoints 2>/dev/null | grep -qE '^[0-9]+$' || _fresh=1
if [[ -n "$_fresh" && -s "${BESTF:-}/FINAL_CKPT" ]]; then
  _bck=$(cat "$BESTF/FINAL_CKPT")
  if [[ -d "$_bck" && -s "$_bck/stats.toml" && "$_bck" != "${START_CK:-}" ]]; then
    echo "$(date '+%F %T %Z') ${RUN:-ST30} start-point rule: START_CK ${START_CK:-unset} -> $_bck (BEST $BESTF)" | tee -a $R_/exp_${RUN:-ST30}/logs/train.log
    START_CK=$_bck; START=
  fi
fi
# Template follows the start point; decided once on the fresh start, reused on resumes.
_tf=$R_/exp_${RUN:-ST30}/TRAIN_TMPL
if [[ -z "$_fresh" && -s "$_tf" ]]; then TRAIN_TMPL=$(cat "$_tf")
else
  if [[ "${BESTF:-}" == */st29_final ]]; then TRAIN_TMPL=train_st30p.toml; else TRAIN_TMPL=train_st30.toml; fi
  mkdir -p $R_/exp_${RUN:-ST30}/logs; echo $TRAIN_TMPL > "$_tf"
  echo "$(date '+%F %T %Z') ${RUN:-ST30} template: $TRAIN_TMPL (BEST ${BESTF:-unset})" | tee -a $R_/exp_${RUN:-ST30}/logs/train.log
fi
# Mid evals every 100M.
CHUNK=100000000
