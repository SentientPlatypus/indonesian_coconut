# shellcheck shell=bash
# TM11 variant (team_launch_tm11.sh). TM10 hyperparameters unchanged; reward
# tm11.toml, setters train_tm11.toml. BT pinned to the TM9 final (team_best at
# staging, user-approved 2026-11-22 7:45 PM ET). team_best is never written.
OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.50; PASTW=1.0
HOLDREL=4000000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-20000000}
STEPS=${STEPS:-5000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:?set B0 to /opt/dlami/nvme/ippo_bins/indococo-train-tm11-<sha>}
REWARD_TMPL=tm11.toml
TRAIN_TMPL=train_tm11.toml
START_IS_TEAM=1
BT_PIN=${BT_PIN:-/home/ubuntu/ippo_runs/exp_TM9/checkpoints/1795388102}
R_=${R:-/home/ubuntu/ippo_runs}
TM3F=$(cat $R_/tm3_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM3F" && -s "$TM3F/actor.bpk" ]] || TM3F=""
GAL_WEIGHT=0.21
NEXTO_WEIGHT=0.30; NEXTO_STOCH=0.2
unset MEGA_WEIGHT NECTO_WEIGHT NECTO_STOCH
EXTRA_OPPS="${TM3F:+TM3_final:$TM3F:0.20}"
CHUNK=${CHUNK:-100000000}
NCR_BASE_2=0.0404; NCR_BASE_3=0.0329
H2H_ALARM=0.45          # vs TM9 now (TM10's 0.50 was vs TM7)
TOUCH_DROP=0.15; DEPTH_DROP=0.20
PASSIVE_BASE=${PASSIVE_BASE:-/home/ubuntu/ippo_runs/tm11_work/passive_base.json}
GAL_JITTER=${GAL_JITTER:-1}
GAL_FIDELITY=${GAL_FIDELITY:-1}
