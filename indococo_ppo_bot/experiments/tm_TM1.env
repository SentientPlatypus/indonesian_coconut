# TM1 (EXPERIMENTS.md "Cross-exam note — TM1"): first 2v2/3v3 run, one shared
# policy, mode mix 1v1 25% / 2v2 40% / 3v3 35% of experience.
# Start: ST36 final (exp_ST36/checkpoints/1794658145, 21349.1M) widened to the
# team-ext obs; fallback ST25 (exp_ST25/checkpoints/1794413355).
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.40; PASTW=1.0
HOLDREL=1500000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-20000000}
STEPS=${STEPS:-3000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:-/opt/dlami/nvme/ippo_bins/indococo-train-tm1-fada713}
R_=${R:-/home/ubuntu/ippo_runs}
START_CK=${START_CK:-$R_/exp_ST36/checkpoints/1794658145}
[[ -s $START_CK/critic.bpk ]] || START_CK=$R_/exp_ST25/checkpoints/1794413355
# League (of the OPPCH share): past selves 1.0, Galactus 0.5, Megabyte 0.25,
# the 1v1 finals ST36/ST25 0.15 each (106-wide, widened on load: they only see
# the first opponent, a "1v1 ballchaser" team).
GAL_WEIGHT=0.5; MEGA_WEIGHT=0.25
EXTRA_OPPS="ST36_1v1:$R_/exp_ST36/checkpoints/1794658145:0.15 ST25_1v1:$R_/exp_ST25/checkpoints/1794413355:0.15"
CHUNK=${CHUNK:-100000000}
