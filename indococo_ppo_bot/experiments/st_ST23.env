# ST23 = ST21 + OPPCH 0.70 + ppo epochs 1 (user-approved restart 4:07 PM ET
# Nov 10). Setter mix is ST21's (no air_dribble_wall_challenge; other setters
# restored from the ST22 x0.9 scale). B0=indococo-train-rip-9d4b2a6.
# Start at launch (not assigned here, so a later follow-up exec can override):
#   START_CK=/home/ubuntu/ippo_runs/exp_ST21/checkpoints/1794296692
#   STEPS=1000000000   # 18053.6M -> 19053.6M
#   BESTF=/home/ubuntu/ippo_runs/st21_final
# Same league weights as ST21/ST22 (GAL 6.429, MEGA 2.0, Ripple toml 1.286,
# others 0.816; total 15.427). With OPPCH 0.70 the realized shares are
# Galactus 29.2%, Ripple 5.8%, Megabyte 9.1%, other league 25.9%, self-play 30%.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
TRAIN_TMPL=train_st23.toml
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
