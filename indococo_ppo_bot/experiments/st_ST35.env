# ST35 (after the ST35 three-way cross-exam, Nov 13): the start point's own
# recipe plus ONE change, the opponent pick: PFSP (src/pfsp.rs, [pfsp] in
# train_st35*.toml). 30% self-play / 20% past versions / 50% adaptive league
# (galactus, megabyte, ripple, ST25_final; HUNT_final and FR4_final pinned at
# the 3% floor). Galactus clamped to [20%, 26%] of all rollouts instead of the
# research's 15% cap. ST13-ST16 and ST20r_final dropped from the league.
#  - ST34 promoted (BESTF=st34_final): train_st35p.toml (st34.toml rewards).
#  - otherwise (BESTF=st25_final): train_st35.toml (st.toml, ST25's recipe).
# Both on the PFSP binary below. League static weights = the PFSP prior mix
# (fallback only if [pfsp] is disabled): GAL 0.20, MEGA 0.09, ST25_final
# 0.09, HUNT_final 0.015 (ripple 0.09 and FR4_final 0.015 are in the toml).
# PPO (1 epoch, no policy bf16, ENT 0.016, gamma 0.998, lambda 0.95), OPPCH
# 0.70 (= 1 - self_share; PFSP sets the pick itself), CHUNK 100M as ST25.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-st35-pfsp-eb14965; GAL_WEIGHT=0.20; MEGA_WEIGHT=0.09
export RIPPLE_DEVICE=cuda
R_=${ST35_R:-/home/ubuntu/ippo_runs}
EXTRA_OPPS="ST25_final:/home/ubuntu/ippo_runs/exp_ST25/checkpoints/1794413355:0.09 HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.015"
# Start-point rule (as ST29-ST34): on a fresh start, use BEST's selected
# checkpoint. The launcher's follow-up sets BESTF=st34_final when ST34 promotes
# (its FINAL_CKPT is the checkpoint the launcher already passes), else the newest
# promote=true final (st25_final -> exp_ST25/checkpoints/1794413355). START is
# cleared so the launcher recomputes it (and END). No effect on resumes.
_fresh=; ls $R_/exp_${RUN:-ST35}/checkpoints 2>/dev/null | grep -qE '^[0-9]+$' || _fresh=1
if [[ -n "$_fresh" && -s "${BESTF:-}/FINAL_CKPT" ]]; then
  _bck=$(cat "$BESTF/FINAL_CKPT")
  if [[ -d "$_bck" && -s "$_bck/stats.toml" && "$_bck" != "${START_CK:-}" ]]; then
    echo "$(date '+%F %T %Z') ${RUN:-ST35} start-point rule: START_CK ${START_CK:-unset} -> $_bck (BEST $BESTF)" | tee -a $R_/exp_${RUN:-ST35}/logs/train.log
    START_CK=$_bck; START=
  fi
fi
# Template follows the start point; decided once on the fresh start, reused on resumes.
_tf=$R_/exp_${RUN:-ST35}/TRAIN_TMPL
if [[ -z "$_fresh" && -s "$_tf" ]]; then TRAIN_TMPL=$(cat "$_tf")
else
  if [[ "${BESTF:-}" == */st34_final ]]; then TRAIN_TMPL=train_st35p.toml; else TRAIN_TMPL=train_st35.toml; fi
  mkdir -p $R_/exp_${RUN:-ST35}/logs; echo $TRAIN_TMPL > "$_tf"
  echo "$(date '+%F %T %Z') ${RUN:-ST35} template: $TRAIN_TMPL (BEST ${BESTF:-unset})" | tee -a $R_/exp_${RUN:-ST35}/logs/train.log
fi
# Mid evals every 100M.
CHUNK=100000000
