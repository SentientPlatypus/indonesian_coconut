# ST31 (passed the Nov 12 Discord/research/code cross-exam; reconciled design)
# = the start point's own recipe plus ONE change, in train_st31*.toml: 0.075 of
# the 0.175 fr7 normal-play replay (kept at 0.10) moves to a replay setter over
# real states 1.5-4.5 s before a NON-demo goal against ST25 by FR4, Galactus,
# Dice, Kira, Ripple and Chronos (st31_snap/preconcede_v2.f32). Capture seeds
# 5000-8549 (v1 windows 1.5/2.5/3.5 s) and 10000-13549 (v2 windows 1.5/2.25/
# 3.0/3.75/4.5 s), disjoint from diag 0-99, ST30's 1000-3399 and finals.
# Kickoff goals and goals within 3.5 s of a demo on us are excluded (ST30's
# lever), so ST31 is independent of ST30's outcome. Unsaveable states dropped
# (ball within 300 uu of our line, or projected in within 1 s with our car not
# goal-side / unable to reach); opponent mix by concede rate, floor 10%,
# Galactus 25% (resampled). Rewards unchanged (st.toml).
# Why: targeted setters are the only lever that moved Galactus; after demos,
# aerial and out-of-position goals are the biggest share of goals conceded to
# Galactus (ST29 22% + 12%) and to FR4 (32% + 22%). See EXPERIMENTS.md ST31.
# Base follows the start point (one change vs the start point's own recipe):
#  - ST30 promoted (BESTF=st30_final): train_st31p.toml = ST30's template
#    (ST25 + 0.05 demo_threat + 0.10 replay over gal_demo_v2.f32).
#  - otherwise (BESTF=st25_final): train_st31.toml = ST25's template.
# Same league as ST25 / ST30 (ST20r_final 2.0 via EXTRA_OPPS, FR4 0.816 in the
# toml, Galactus 6.429, Megabyte 2.0, Ripple 1.286 in the toml), OPPCH 0.70,
# 1 epoch, CHUNK 100M, reward st.toml (flip_reset 70), binary 9d4b2a6.
# Do NOT set RIPPLE_WEIGHT here: the trainer would override the toml.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.70; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/opt/dlami/nvme/ippo_bins/indococo-train-rip-9d4b2a6; GAL_WEIGHT=6.429; MEGA_WEIGHT=2.0
export RIPPLE_DEVICE=cuda
R_=${ST31_R:-/home/ubuntu/ippo_runs}
EXTRA_OPPS="ST13_final:$R_/exp_ST13/checkpoints/1794063148:0.816 ST14_final:$R_/exp_ST14/checkpoints/1794079621:0.816 ST15_final:$R_/exp_ST15/checkpoints/1794111431:0.816 ST16_final:$R_/exp_ST16/checkpoints/1794133863:0.816"
EXTRA_OPPS="$EXTRA_OPPS HUNT_final:/home/ubuntu/ippo_runs/exp_HUNT/checkpoints/1794067059:0.816"
EXTRA_OPPS="$EXTRA_OPPS ST20r_final:/home/ubuntu/ippo_runs/exp_ST20r/checkpoints/1794276990:2.0"
# Start-point rule (as ST29/ST30): on a fresh start, use BEST's selected
# checkpoint. The launcher's follow-up sets BESTF=st30_final when ST30 promotes
# (its FINAL_CKPT is the checkpoint the launcher already passes), else the newest
# promote=true final (st25_final -> exp_ST25/checkpoints/1794413355). START is
# cleared so the launcher recomputes it (and END). No effect on resumes.
_fresh=; ls $R_/exp_${RUN:-ST31}/checkpoints 2>/dev/null | grep -qE '^[0-9]+$' || _fresh=1
if [[ -n "$_fresh" && -s "${BESTF:-}/FINAL_CKPT" ]]; then
  _bck=$(cat "$BESTF/FINAL_CKPT")
  if [[ -d "$_bck" && -s "$_bck/stats.toml" && "$_bck" != "${START_CK:-}" ]]; then
    echo "$(date '+%F %T %Z') ${RUN:-ST31} start-point rule: START_CK ${START_CK:-unset} -> $_bck (BEST $BESTF)" | tee -a $R_/exp_${RUN:-ST31}/logs/train.log
    START_CK=$_bck; START=
  fi
fi
# Template follows the start point; decided once on the fresh start, reused on resumes.
_tf=$R_/exp_${RUN:-ST31}/TRAIN_TMPL
if [[ -z "$_fresh" && -s "$_tf" ]]; then TRAIN_TMPL=$(cat "$_tf")
else
  if [[ "${BESTF:-}" == */st30_final ]]; then TRAIN_TMPL=train_st31p.toml; else TRAIN_TMPL=train_st31.toml; fi
  mkdir -p $R_/exp_${RUN:-ST31}/logs; echo $TRAIN_TMPL > "$_tf"
  echo "$(date '+%F %T %Z') ${RUN:-ST31} template: $TRAIN_TMPL (BEST ${BESTF:-unset})" | tee -a $R_/exp_${RUN:-ST31}/logs/train.log
fi
# Mid evals every 100M.
CHUNK=100000000
