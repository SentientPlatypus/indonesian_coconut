# shellcheck shell=bash
# TM14 variant (run by team_launch_tm13.sh with RUN=TM14 VARIANT=TM14 and C=code_tm14,
# started by wait_tm13_launch_tm14.sh). TM13 settings plus GCO (tm14.toml: every
# non-goal term anneals to 0 over the first 500M steps, then goal/concede only).
# Train template is TM13's (train_tm13.toml: Galactus PFSP [0.10, 0.18],
# self_share 0.55, entropy 0.008, P1+L1+L2, 1 epoch, no bf16). Lever 4 on at
# 0.15. L3 small critic off. Critic extras off. Start = TM13 FINAL_CKPT (the
# waiter sets START_CK). BT stays pinned to the TM10 final. team_best is never
# written. EXPERIMENTS.md "TM14 — Cross-exam note".
# Do not use ${LEVER4:-0} here: the launcher re-reads this one line every chunk.
LEVER4=1

OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.008; OPPCH=0.50; PASTW=1.0
# 3B steps: LR holds for 2B, then cosine to 0.4x over the last 1B.
HOLDREL=2000000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-20000000}
STEPS=${STEPS:-3000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:?set B0 to /opt/dlami/nvme/ippo_bins/indococo-train-tm14-<sha>}
REWARD_TMPL=tm14.toml
TRAIN_TMPL=train_tm13.toml
START_IS_TEAM=1
START_CK=${START_CK:?the waiter sets START_CK (TM13 FINAL_CKPT)}
BT_PIN=${BT_PIN:-/home/ubuntu/ippo_runs/exp_TM10/checkpoints/1795503212}
R_=${R:-/home/ubuntu/ippo_runs}
TM3F=$(cat $R_/tm3_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM3F" && -s "$TM3F/actor.bpk" ]] || TM3F=""
GAL_WEIGHT=0.21
NEXTO_WEIGHT=0.30; NEXTO_STOCH=0.2
NEXTO_KICKOFF_SCRIPT=${NEXTO_KICKOFF_SCRIPT:-true}
unset MEGA_WEIGHT NECTO_WEIGHT NECTO_STOCH
EXTRA_OPPS="${TM3F:+TM3_final:$TM3F:0.20}"
CHUNK=${CHUNK:-100000000}
NCR_BASE_2=${NCR_BASE_2:-}
NCR_BASE_3=${NCR_BASE_3:-}
H2H_ALARM=0.45          # vs TM10
TOUCH_DROP=0.15; DEPTH_DROP=0.20
# The waiter writes this from TM13's start-checkpoint mid (touch_/depth_) and
# TM13's last-500M training goals/min (train_goals_min).
PASSIVE_BASE=${PASSIVE_BASE:-/home/ubuntu/ippo_runs/tm14_work/passive_base.json}
GAL_JITTER=${GAL_JITTER:-1}
GAL_FIDELITY=${GAL_FIDELITY:-1}
CRITIC_EXTRAS=0
TM9_PIN=${TM9_PIN:-/home/ubuntu/ippo_runs/exp_TM9/checkpoints/1795388102}
TM9_GAMES=${TM9_GAMES:-400}
ENTROPY_ALARM=${ENTROPY_ALARM:-3.2}
# TM14 abort set (tm12_eval.py alarm; 2 mids in a row -> PASSIVE_ALARM line).
# Exported so the alarm subprocess sees them. Training-window rules average
# metrics.jsonl rows between the previous mid and this one.
export DC2_MAX=0.02 PAIR800_3_MAX=0.22 NEXTO3_MIN=0.45 SPS_MIN=55000
export GOALS_DROP=0.25 ENTROPY_HIGH=3.95
NEXTO_REPLICAS=${NEXTO_REPLICAS:-8}
NEXTO_CHUNK=${NEXTO_CHUNK:-64}
NF_INTRA=${NF_INTRA:-2}
CONCURRENT_MIDS=${CONCURRENT_MIDS:-0}
# Same TM13 pre-goal banks (read-only). Launcher substitutes @PREGOAL@.
PREGOAL=${PREGOAL:-/opt/dlami/nvme/tm13_work/pregoal}
