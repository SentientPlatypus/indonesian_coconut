# TM8 (EXPERIMENTS.md "TM8 — Cross-exam note"): TM7 plus the TM8 team audit
# fixes, the research-leg modifications and the three user-approved tweaks
# (Nov 19 2026, 5:05 PM ET). Reward tm8.toml (extends tm7.toml): shadow_cover
# 1.5 (200M ramp 0.25 -> 1, x0.5 at kickoff), approach terms out of per-term
# zero-sum, obs-consistent role tie-break + touch hysteresis, kickoff same-pad
# / taker penalties, kickoff positioning restored, contact_quality 250 -> 100
# over 200M, open-net air-dribble gate x0.05 (possession, ball < 4000 uu from
# the line, every defender >= 200 uu behind the ball), clear_path 300 (+50% for
# a goal within 2 s); TM7 spacing / last-man / support ramps held at their end
# values. Train train_tm8.toml: setters kickoff 0.15, breakaway 0.05,
# goalie_shot 0.05; PFSP 65 self / 20 past / 15 league (Nexto, Galactus, TM3
# final) with f_hard and clamps (Nexto 5-10%, Galactus <= 6%, TM3 <= 6% of all
# rollouts). Obs 270 (warm start as is). Start = TM7's last checkpoint (passed
# as START_CK by tm8_after_tm7.sh; $R_/TM8_START_CK overrides). BT = team_best
# = TM6 final (exp_TM6/checkpoints/1795044069), pinned in team_launch_tm8.sh.
# 1 epoch, no bf16, CHUNK 100M; critic warm-up 20M; 5B steps, LR 5e-5 held to
# STEPS-1B then 1B cosine to 0.4x.
OBS_PRED=1
GAMMA=0.995; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.50; PASTW=1.0
HOLDREL=4000000000; DECAY=1_000_000_000; MINLR=0.4; WARM_REL=${WARM_REL:-20000000}
STEPS=${STEPS:-5000000000}; TPI=${TPI_OVERRIDE:-$TPI}
B0=${B0:-/opt/dlami/nvme/ippo_bins/indococo-train-tm8-5005500}
REWARD_TMPL=${REWARD_TMPL:-tm8.toml}; TRAIN_TMPL=${TRAIN_TMPL:-train_tm8.toml}
R_=${R:-/home/ubuntu/ippo_runs}
START_IS_TEAM=${START_IS_TEAM:-1}
TBF=$(cat $R_/team_best/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TBF" && -s "$TBF/actor.bpk" ]] || TBF=""
START_CK=${START_CK:-}
[[ -s $R_/TM8_START_CK ]] && START_CK=$(cat $R_/TM8_START_CK)
TM3F=$(cat $R_/tm3_final/FINAL_CKPT 2>/dev/null || true)
[[ -n "$TM3F" && -s "$TM3F/actor.bpk" ]] || TM3F=""
# League (PFSP [pfsp] in train_tm8.toml decides the shares; the static weights
# below only matter if PFSP is off): Nexto (20% of its episodes sampled),
# Galactus, TM3 final (270-wide). Necto, Megabyte, ST25 1v1 and TM2 final are
# out of the training league (still evaluated at every mid).
GAL_WEIGHT=0.21
NEXTO_WEIGHT=0.30; NEXTO_STOCH=0.2
unset MEGA_WEIGHT NECTO_WEIGHT NECTO_STOCH
EXTRA_OPPS="${TM3F:+TM3_final:$TM3F:0.20}"
CHUNK=${CHUNK:-100000000}
# Passive alarm (team_launch_tm8.sh), any rule for 2 mids in a row ->
# $X/PASSIVE_ALARM: TM7's rules and thresholds (passes 2v2 < 0.85 / 3v3 < 1.30;
# deep > 0.56 / 0.73 with h2h < 0.48; Nexto 2v2 < 0.40 / 3v3 < 0.20; near2 <
# 0.06 / 0.10; no-challenger > 1.5x NCR_BASE = 0.061 / 0.049) with h2h vs
# BEST-team (now TM6 final) < 0.50, plus passivity vs TM7's final: touches per
# car-minute < (1 - TOUCH_DROP) x base, deepest-car depth < (1 - DEPTH_DROP) x
# base, per mode.
NCR_BASE_2=0.0404; NCR_BASE_3=0.0329
H2H_ALARM=0.50
PASSIVE_BASE=${PASSIVE_BASE:-/opt/dlami/nvme/tm8_work/cut/passive_base.json}
TOUCH_DROP=0.15; DEPTH_DROP=0.20
