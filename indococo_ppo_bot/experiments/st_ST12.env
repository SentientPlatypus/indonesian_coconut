# ST12 (generalization): ST11 recipe (OPPCH 0.55 + ENT 0.016 + ST4..ST8 frozen
# finals in EXTRA_OPPS + Megabyte @ w2.0 via indococo-train-mega) with one change:
# add ST9_final (new BEST 9628.4M) to the league at w1.0 so training also faces
# the newest promoted style. Galactus 2.5, Megabyte 2.0, flip_reset 70. From ST11 best.
# Hypothesis: after ST9 cleared gates with a Galactus dip, folding the new best
# into EXTRA_OPPS while keeping Megabyte diversity should stabilize the panel
# across the latest ST eras without overweighting any single opponent.
GAMMA=0.998; TPI=300_000; MB=100_000; LR=5e-5; ENT=0.016; OPPCH=0.55; HOLDREL=600000000; DECAY=400_000_000; MINLR=0.4
B0=/home/ubuntu/ippo_runs/code_fr9/bin/indococo-train-mega; GAL_WEIGHT=2.5; MEGA_WEIGHT=2.0
R_=/home/ubuntu/ippo_runs
EXTRA_OPPS="X0_final:$R_/exp_X0/checkpoints/1793405254:1.0 ADB_final:$R_/exp_ADB/checkpoints/1793420157:1.0 AUD_final:$R_/exp_AUD/checkpoints/1793475982:1.0 FR6_final:$R_/exp_FR6/checkpoints/1793540902:1.0 FR8c_final:$R_/exp_FR8c/checkpoints/1793716845:1.0 FR9c_final:$R_/exp_FR9c/checkpoints/1793762362:1.0 ST3_final:$R_/exp_ST3/checkpoints/1793809757:1.0 ST4_final:$R_/exp_ST4/checkpoints/1793831734:1.0 ST5_final:$R_/exp_ST5/checkpoints/1793851923:1.0 ST6_final:$R_/exp_ST6/checkpoints/1793887366:1.0 ST7_final:$R_/exp_ST7/checkpoints/1793909607:1.0 ST8_final:$R_/exp_ST8/checkpoints/1793939483:1.0 ST9_final:$R_/exp_ST9/checkpoints/1793962509:1.0"
